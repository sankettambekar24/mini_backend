# Hybrid Secure Storage System — Backend Environment Variables
# Copy this file to .env and fill in real values locally.
# NEVER commit .env or any file containing real secrets.

# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_MINIMUM_50_CHARS
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Neon PostgreSQL connection string — use TLS-enabled URL from Neon dashboard)
# Leave empty to use local SQLite for development only.
# Production MUST use a real Neon PostgreSQL URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DB_SSL_REQUIRE=true

# CORS — comma-separated list of allowed origins (no trailing slash, no wildcards with credentials)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT — optional for local development; production requires an independent key.
# Configure a high-entropy key distinct from DJANGO_SECRET_KEY in Render secret settings.
JWT_SIGNING_KEY=

# CSRF trusted origins for production proxy
CSRF_TRUSTED_ORIGINS=https://YOUR_RENDER_DOMAIN.onrender.com

# Render (set automatically by Render; not needed locally)
RENDER_EXTERNAL_HOSTNAME=

# Required in production: shared Redis cache for authentication rate limiting.
# Local development and isolated tests can leave this empty and use LocMemCache.
REDIS_URL=

# Proxy & IP handling (protects against IP spoofing)
# Set to 'true' in production behind Render or Cloudflare reverse proxies.
USE_X_FORWARDED_FOR=false
NUM_PROXIES=1

# Optional: Sentry error monitoring DSN
SENTRY_DSN=
