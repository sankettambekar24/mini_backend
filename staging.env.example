# Copy to staging.env (ignored by Git) and fill from your secret manager.
# Never put real credentials in this tracked example file.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=REPLACE_WITH_STAGING_ONLY_RANDOM_SECRET_AT_LEAST_50_CHARS
JWT_SIGNING_KEY=REPLACE_WITH_A_DIFFERENT_STAGING_ONLY_RANDOM_SECRET_AT_LEAST_50_CHARS
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_SSL_REQUIRE=true

# Runtime pooled URL. Use the Neon hostname containing -pooler.
DATABASE_URL=postgresql://ROLE:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/STAGING_DB?sslmode=require

# Direct URL for operator migration procedure only. Never substitute it in
# Render's runtime config. The connectivity script only runs read-only SELECTs.
NEON_DIRECT_DATABASE_URL=postgresql://ROLE:PASSWORD@ep-example.REGION.aws.neon.tech/STAGING_DB?sslmode=require

# Exact endpoint hosts copied from the new staging branch's Connect dialog.
# The checker refuses to connect unless both URLs match these values exactly.
STAGING_EXPECTED_NEON_POOLED_HOST=REPLACE_WITH_STAGING_POOLED_HOST
STAGING_EXPECTED_NEON_DIRECT_HOST=REPLACE_WITH_STAGING_DIRECT_HOST
# The branch ID/name is an operator record from the Neon console; endpoint
# hostname allow-listing is the machine-enforced branch routing guard.
STAGING_NEON_BRANCH_ID=REPLACE_WITH_STAGING_BRANCH_ID

# Upstash native TCP connection URL. This must use rediss://, not REST URL/token.
REDIS_URL=rediss://default:TOKEN@YOUR_ENDPOINT.upstash.io:6379

# Exact database name expected by the connectivity script (no credentials).
STAGING_EXPECTED_DB_NAME=REPLACE_WITH_STAGING_DATABASE_NAME
